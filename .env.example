# Core AI (required for Sheila)
OPENAI_API_KEY=your_openai_api_key_here
# Optional model override
OPENAI_MODEL=gpt-4.1-mini

# Optional: Drive live indexing
GOOGLE_DRIVE_FOLDER_ID=your_shared_drive_folder_id
GOOGLE_DRIVE_CLIENT_SECRET_FILE=C:\\path\\to\\client_secret_xxx.json
# OR use a service account JSON inline
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# OR use a service account file path instead of embedding the JSON inline
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=C:\\path\\to\\service-account.json

# Optional local filesystem fallback
SHARED_DRIVE_PATH=C:\\path\\to\\synced\\company\\drive

# Email
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password

# Calendar
CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/your_email%40domain.com/public/basic.ics

# Optional integrations
ASANA_PAT=your_asana_pat
ZAVU_API_KEY=your_zavu_api_key_here
# Created/shown by Zavu when configuring a sender webhook; keep it local.
ZAVU_WEBHOOK_SECRET=your_zavu_webhook_secret_here
# Optional local development listener; avoids the PRCC app on port 3000.
ZAVU_WEBHOOK_PORT=3002
PERPLEXITY_API_KEY=your_perplexity_key
ANTHROPIC_API_KEY=your_anthropic_key

# Durable Sheila operational state (Render Postgres; required in production)
SHEILA_OPERATIONAL_DATABASE_URL=postgresql://user:password@host:5432/sheila
SHEILA_USER_ID=sam
# Set true in production; Render defaults this to true automatically.
SHEILA_REQUIRE_OPERATIONAL_DATABASE=true
# Destination for scheduled reminder delivery through the existing Zavu sender.
SHEILA_REMINDER_RECIPIENT=+14155551234
SHEILA_REMINDER_CHANNEL=whatsapp
# Optional when the configured Zavu account requires a sender identifier.
SHEILA_REMINDER_SENDER_ID=
# Secret for the external scheduler calling POST /internal/reminders/run.
SHEILA_REMINDER_WORKER_TOKEN=replace_with_a_long_random_secret

# Production durable-memory provider. Use "local" only for local development.
SHEILA_MEMORY_BACKEND=second_brain
SHEILA_MEMORY_FALLBACK=true
SECOND_BRAIN_URL=https://your-sam-2-host.example
SECOND_BRAIN_SERVICE_TOKEN=your_sam_2_service_token
SECOND_BRAIN_USER_ID=your_sam_2_user_id
SECOND_BRAIN_TIMEOUT=10
