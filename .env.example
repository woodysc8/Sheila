# Core AI
GEMINI_API_KEY=your_gemini_key_here
GEMINI_API_KEYS=your_gemini_key_here

# Optional: Drive live indexing
GOOGLE_DRIVE_FOLDER_ID=your_shared_drive_folder_id
GOOGLE_DRIVE_CLIENT_SECRET_FILE=C:\\path\\to\\client_secret_xxx.json
# OR use a service account JSON inline
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# OR use a service account file path instead of embedding the JSON inline
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=C:\\path\\to\\service-account.json

# Optional local filesystem fallback
SHARED_DRIVE_PATH=C:\\path\\to\\synced\\company\\drive

# Email
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password

# Calendar
CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/your_email%40domain.com/public/basic.ics

# Optional integrations
ASANA_PAT=your_asana_pat
PERPLEXITY_API_KEY=your_perplexity_key
ANTHROPIC_API_KEY=your_anthropic_key
